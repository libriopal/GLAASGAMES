# GLASSBOX v6 Phase 2 — regenerated 2026-08-01 (admin/user DB split)
# NEVER commit this file. Re-run ./setup-env.sh to change values.
#
# The previous .env had corrupted, concatenated values on DATABASE_URL and
# GEMINI_API_KEY (each appeared to be several completions glued together,
# still containing an unresolved [YOUR-PASSWORD] placeholder in one case).
# Rather than guess at which fragment was real, every value below that
# could not be independently verified via the Supabase MCP was left blank.
# SUPABASE_URL_* and SUPABASE_ANON_KEY_* below were fetched directly from
# the live Supabase projects just now and are known-correct.

# --- Persistence: ADMIN database (P1 onward) ---
# accounts, organisms, harvest_runs, gate_results, audit_log, converged_seeds
# Project: Glassbox_Labs/admin (tstwsszlkucmlozlttnn)
DATABASE_URL_ADMIN=
SUPABASE_URL_ADMIN=
SUPABASE_ANON_KEY_ADMIN=
SUPABASE_SERVICE_ROLE_KEY_ADMIN=

# --- Persistence: USER database (P1 onward) ---
# sessions, session_events, telemetry_events, contested_states, rater_judgments
# Project: Glassbox_Labs/user (nimgivdwcslipgtgiann)
DATABASE_URL_USER=
SUPABASE_URL_USER=
SUPABASE_ANON_KEY_USER=
SUPABASE_SERVICE_ROLE_KEY_USER=

# --- LLM (P9 only) ---
GROQ_API_KEY=
GEMINI_API_KEY=
