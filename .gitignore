node_modules/
.claude/
.env
.env.*
!.env.example

# OpenClaude settings are GENERATED from .openclaude/settings.template.json by
# scripts/termux-setup.sh and contain a live Cloudflare API token. The template is
# tracked; the generated file must never be.
.openclaude/settings.json

# The real env file lives at $HOME/.env, outside the tree. This entry catches a copy
# accidentally made inside the repo before verify-no-secrets has to.
.env
.env.local

# Compiled browser bundle, regenerated by `npm run build:web`.
web/dist/

# Android build outputs and local SDK pointer. The staged assets are generated
# by scripts/build-app-assets.mjs and are not a source of truth.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/
build/app-assets/
*.jks
*.keystore

# The Gradle wrapper JAR is committed deliberately: it is what pins the Gradle
# version for CI and for anyone cloning. AGP 8.13 uses an internal API removed
# in Gradle 9.6, and GitHub's runners ship 9.7 — without this the build works
# locally and fails in CI, which is exactly what happened.
!android/gradle/wrapper/gradle-wrapper.jar
