<?xml version="1.0" encoding="utf-8"?>
<!-- The app stores nothing worth backing up: the daily world is derived from the
     date, so a restored device recomputes it rather than needing it copied. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
